#!/usr/bin/env bash
set -euo pipefail
umask 077

config_file="${PUBLISHABLE_CONFIG_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/publishable/config}"
configured_rules=""
configured_ready=""

if [ -f "$config_file" ]; then
  while IFS='=' read -r raw_key raw_value; do
    key="${raw_key#"${raw_key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    value="${raw_value#"${raw_value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$value" in
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
    esac
    case "$key" in
      rules_path) configured_rules="$value" ;;
      rules_ready) configured_ready="$value" ;;
    esac
  done < "$config_file"
fi

if [ -n "$configured_rules" ]; then
  personal_config="$configured_rules"
elif [ -n "${PUBLISHABLE_RULES_PATH:-}" ]; then
  personal_config="$PUBLISHABLE_RULES_PATH"
else
  personal_config="${XDG_CONFIG_HOME:-${HOME}/.config}/publishable/personal.toml"
fi

remote_name="${1:-<remote>}"

if [ -n "$configured_ready" ]; then
  case "$configured_ready" in
    true|TRUE|yes|YES|1) ;;
    *)
      printf '%s\n' "BLOCKED by publish-safety pre-push: the local rules file still has starter status." >&2
      printf 'Fix: replace every placeholder in %s, then set rules_ready=true in %s.\n' "$personal_config" "$config_file" >&2
      printf 'Deliberate override: git push --no-verify %q\n' "$remote_name" >&2
      exit 1
      ;;
  esac
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '%s\n' "BLOCKED by publish-safety pre-push: required scanner gitleaks is not on PATH." >&2
  printf '%s\n' "Fix: install gitleaks from its official release or your operating system's package manager." >&2
  printf 'Deliberate override: git push --no-verify %q\n' "$remote_name" >&2
  exit 1
fi

if [ ! -f "$personal_config" ]; then
  printf '%s\n' "BLOCKED by publish-safety pre-push: the local gitleaks config is missing." >&2
  printf 'File: %s\n' "$personal_config" >&2
  printf '%s\n' "Rule: scanner-configuration" >&2
  printf 'Fix: create and customise %s, then rerun the push.\n' "$personal_config" >&2
  printf 'Deliberate override: git push --no-verify %q\n' "$remote_name" >&2
  exit 1
fi

repo="$(git rev-parse --show-toplevel)"
report="$(mktemp "${TMPDIR:-/tmp}/publishable-pre-push.XXXXXX")"
trap 'rm -f "$report"' EXIT

is_zero_oid() {
  case "$1" in
    ''|*[!0]*) return 1 ;;
    *) return 0 ;;
  esac
}

print_history_fix() {
  local commit="$1"
  if git -C "$repo" rev-parse "${commit}^" >/dev/null 2>&1; then
    printf 'Fix: git -C %q rebase -i %q; edit or drop the flagged commit, then rerun git push\n' \
      "$repo" "${commit}^" >&2
  else
    printf 'Fix: git -C %q rebase -i --root; edit or drop the flagged commit, then rerun git push\n' \
      "$repo" >&2
  fi
}

blocked=0
ai_name_pattern='Clau[d]e'
ai_vendor_pattern="${ai_name_pattern}|Anthropic"
attribution_pattern="Co-Authored-By:[[:space:]]*.*${ai_name_pattern}|Generated[[:space:]]+with[[:space:]]+${ai_name_pattern}|Author[[:space:]]+of[[:space:]]+this[[:space:]]+doc:[[:space:]]*${ai_name_pattern}"
# shellcheck disable=SC2034  # git's pre-push protocol sends four fields per line; local_ref
# and remote_ref must be read to reach the oids, even though only the oids are used.
while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  is_zero_oid "$local_oid" && continue

  if is_zero_oid "$remote_oid" || ! git -C "$repo" cat-file -e "${remote_oid}^{commit}" 2>/dev/null; then
    range="$local_oid"
  else
    range="${remote_oid}..${local_oid}"
  fi

  : > "$report"
  scan_rc=0
  gitleaks detect \
    --source "$repo" \
    --log-opts "$range" \
    --config "$personal_config" \
    --redact=100 \
    --report-format json \
    --report-path "$report" \
    --no-banner \
    --no-color \
    --log-level error >/dev/null 2>&1 || scan_rc=$?

  if command -v jq >/dev/null 2>&1; then
    if [ "$scan_rc" -eq 1 ] && jq -e 'type == "array" and length > 0' "$report" >/dev/null 2>&1; then
      blocked=1
      printf 'BLOCKED by publish-safety pre-push: outgoing range %s contains publish-sensitive data.\n' "$range" >&2
      while IFS=$'\t' read -r file line commit rule description; do
        printf 'Finding: %s:%s commit=%s [%s] %s\n' "$file" "$line" "$commit" "$rule" "$description" >&2
        print_history_fix "$commit"
      done < <(jq -r '.[] | [.File, (.StartLine | tostring), .Commit, .RuleID, .Description] | @tsv' "$report")
    elif [ "$scan_rc" -ne 0 ]; then
      blocked=1
      printf '%s\n' "BLOCKED by publish-safety pre-push: gitleaks failed before producing a valid finding report." >&2
      printf '%s\n' "File: <scanner>" >&2
      printf '%s\n' "Rule: scanner-error" >&2
      printf 'Fix: gitleaks detect --source %q --log-opts %q --config %q --redact=100 --verbose\n' \
        "$repo" "$range" "$personal_config" >&2
    fi
  elif [ "$scan_rc" -eq 1 ]; then
    blocked=1
    printf 'BLOCKED by publish-safety pre-push: outgoing range %s contains one or more publish-sensitive values.\n' "$range" >&2
    printf '%s\n' "Detail is unavailable because jq is not installed; no secret value was printed." >&2
    printf '%s\n' "Fix: install jq, then rerun the push for per-finding remediation." >&2
  elif [ "$scan_rc" -ne 0 ]; then
    blocked=1
    printf '%s\n' "BLOCKED by publish-safety pre-push: gitleaks failed before completing the scan." >&2
    printf '%s\n' "Fix: check the scanner and local rules configuration, then rerun the push." >&2
  fi

  while IFS= read -r commit; do
    [ -n "$commit" ] || continue
    author_meta="$(git -C "$repo" show -s --format='%an%n%ae' "$commit")"
    body="$(git -C "$repo" show -s --format='%B' "$commit")"
    metadata_rule=""
    if printf '%s\n' "$author_meta" | grep -qiE "$ai_vendor_pattern"; then
      metadata_rule="ai-author-metadata"
    elif printf '%s\n' "$body" | grep -qiE "$attribution_pattern"; then
      metadata_rule="ai-attribution-commit-message"
    fi
    if [ -n "$metadata_rule" ]; then
      blocked=1
      printf 'BLOCKED by publish-safety pre-push: commit metadata contains AI authorship attribution.\n' >&2
      printf 'Finding: commit=%s [%s] Remove AI attribution and keep the human author solely responsible.\n' \
        "$commit" "$metadata_rule" >&2
      print_history_fix "$commit"
    fi
  done < <(git -C "$repo" rev-list "$range")
done

if [ "$blocked" -ne 0 ]; then
  printf 'Deliberate override: git push --no-verify %q\n' "$remote_name" >&2
  exit 1
fi

exit 0
